# Copier en server/.env pour le développement local (jamais commité).
NODE_ENV=development
PORT=8080
# En local, passer par le proxy Vite pour que front et API partagent la même origine.
PUBLIC_BASE_URL=http://localhost:5173

TENANT_ID=00000000-0000-0000-0000-000000000000
PARTNER_TENANT_ID=00000000-0000-0000-0000-000000000000
PARTNER_DISPLAY_NAME=Partenaire
# Autorise les comptes internes (membres) ayant le rôle Room.Booker — pour les tests uniquement.
ALLOW_INTERNAL_USERS=true

# App registration de connexion. En local : secret d'une app registration de DEV.
# En Azure : aucun secret, la Managed Identity est le credential fédéré.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=

# Accès Graph en local : app registration de DEV couverte par Exchange RBAC for Applications.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=

ORGANIZER_UPN=resa-externe@contoso.com
ALLOWED_ATTENDEE_DOMAINS=contoso.com,partenaire.com
# Salles masquées du portail (ni affichées, ni réservables) : adresses exactes ou motifs avec « * ».
# Ex. : EXCLUDED_ROOMS=salle-direction@contoso.com,*-labo@contoso.com
EXCLUDED_ROOMS=

# Azurite en local (en Azure : STORAGE_TABLE_ENDPOINT + Managed Identity).
STORAGE_TABLE_ENDPOINT=http://127.0.0.1:10002/devstoreaccount1
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# 32 caractères minimum : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

TIME_ZONE=Europe/Paris
BOOKING_DAY_START=08:00
BOOKING_DAY_END=19:00
BOOKING_SLOT_MINUTES=15
BOOKING_MAX_DURATION_MINUTES=240
BOOKING_HORIZON_DAYS=30
BOOKING_MAX_ACTIVE_PER_USER=10
BOOKING_ALLOW_WEEKENDS=false
